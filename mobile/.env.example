# LifeLink Mobile Environment Variables

# Backend API base URL (no trailing slash)
API_BASE_URL=http://127.0.0.1:8000/api

# WebSocket base URL for real-time chat
WS_BASE_URL=ws://127.0.0.1:8000/ws

# Google Maps (Android/iOS — configure in platform-specific files too)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Firebase (push notifications + analytics)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_PROJECT_ID=your-project-id

# Cloudinary (optional media uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# Default locale: en | fr
DEFAULT_LANGUAGE=en
